<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Bootstrap demo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>

<body>
    <div class="container mt-10">
        <h1>Product List</h1>
        <a href="/product/create" class="btn btn-info">Add Product</a> || <a href="/" class="btn btn-warning">Recycle Bin</a>
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Sl.No</th>
                    <th scope="col">Id</th>
                    <th scope="col">Name</th>
                    <th scope="col">Price</th>
                    <th scope="col">Description</th>
                    <th scope="col">Brand</th>
                    <th scope="col">image</th>
                    <th colspan="4">Action</th>
                </tr>
            </thead>
            <% for(let products of product) {%>
            <tbody>
                <tr>
                    <th scope="row">1</th>
                    <th scope="row"><%= products.id %></th>
                    <td><%= products.name %></td>
                    <td><%= products.price %></td>
                    <td><%= products.description %></td>
                    <td><%= products.brand %></td>
                    <td><img src="<%= products.image %>" width="50px" height="50px"></td>
                    <td><a href="/product/edit/<%= products._id %>" class="btn btn-primary">Edit</a></td> 
                    <td><a href="" class="btn btn-success">view</a></td>
                    <td><a href="/product/delete/<%= products._id %>" class="btn btn-danger">Delete</a></td>
                    <td><a href="/product/softdelete/<%= products._id %>" class="btn btn-warning">Soft Delete</a></td>
                </tr>
                
            </tbody>
            <%}%>
        </table>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>
</body>

</html>